rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match the 'users' collection and specific user ID
    match /users/{userId} {
      // Allow read/write to the user document itself
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow read/write to all subcollections (e.g., 'history', 'plans') for that user
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
